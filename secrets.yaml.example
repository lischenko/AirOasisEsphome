# Copy to secrets.yaml and replace all values. secrets.yaml is Git-ignored.
# Use a unique API key and OTA/fallback passwords for this controller.

wifi_ssid: "your-wifi-ssid"
wifi_password: "replace-with-wifi-password"
api_encryption_key: "replace-with-a-32-byte-base64-key"
ota_password: "replace-with-a-long-random-password"
fallback_ap_password: "replace-with-a-long-random-password"
